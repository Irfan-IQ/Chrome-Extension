# ==============================================================================
# Redact Agent — Backend Configuration
# ==============================================================================

# Server Network Settings
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Operational Engine Mode:
#   "gemini_cloud" : Routes requests to Gemini API (fast prototype demo on laptops/MacBook)
#   "local_vlm"    : Routes requests to local offline VLM (e.g. Qwen2.5-VL / Ollama / vLLM)
BACKEND_MODE=gemini_cloud

# Cloud Provider Settings (active when BACKEND_MODE=gemini_cloud)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local VLM Settings (active when BACKEND_MODE=local_vlm)
LOCAL_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
LOCAL_VLM_ENDPOINT=http://localhost:11434/v1
# Device options: auto, mps (Apple Silicon), cuda (NVIDIA), cpu
DEVICE=auto
