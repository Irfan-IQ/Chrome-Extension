# ==============================================================================
# REDACT AGENT SERVER CONFIGURATION
# Optimized for Qwen2.5-14B on NVIDIA A100 (40 GB VRAM) & Minimal Fallbacks
# ==============================================================================

# Server Network & Process Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false
WORKERS=1
TIMEOUT_KEEP_ALIVE=30
BACKLOG=2048
LIMIT_CONCURRENCY=1000

# CORS & Extension Security
# In production, set to your extension's ID: CORS_ORIGINS=chrome-extension://<extension-id>
CORS_ORIGINS=*

# Shared-Secret Bearer Token (optional for local dev, mandatory for shared deployment)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# Concurrency & Backpressure Guard
MAX_CONCURRENT_REQUESTS=32
REQUEST_QUEUE_TIMEOUT=30.0

# Prompt & Prefix Caching Layer (APC memoization)
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_SIZE=1024
PROMPT_CACHE_TTL=3600.0

# Async Micro-Batch Coordinator (dynamic continuous batching)
BATCHING_ENABLED=false
BATCH_MAX_SIZE=8
BATCH_MAX_DELAY_MS=15.0

# ==============================================================================
# BACKEND MODES: gemini_cloud | local_vlm | vllm | llamacpp
# ==============================================================================
BACKEND_MODE=vllm

# --- Mode 1: vLLM on NVIDIA A100 (40 GB VRAM) - RECOMMENDED PRODUCTION ---
# Qwen2.5-14B-Instruct with AWQ 4-bit quantization fits model in ~8-9 GB VRAM,
# dedicating >30 GB strictly to KV-cache for 32-64 concurrent sequences.
VLLM_ENDPOINT=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=8192
QUANTIZATION=awq
KV_CACHE_DTYPE=auto
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=4096
TENSOR_PARALLEL_SIZE=1
ENFORCE_EAGER=false
VLLM_API_KEY=

# --- Mode 2: Local VLM (Ollama / OpenAI-compatible proxy) ---
LOCAL_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
LOCAL_VLM_ENDPOINT=http://localhost:11434/v1
DEVICE=auto

# --- Mode 3: Gemini Cloud Fallback ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Mode 4: Minimal Resource Fallback (llama.cpp / CPU-only) ---
LLAMACPP_ENDPOINT=http://localhost:8080/v1
LLAMACPP_MODEL=qwen2.5-14b-instruct-q4_k_m.gguf
LLAMACPP_THREADS=6
LLAMACPP_N_GPU_LAYERS=0
