# ==============================================================================
# REDACT AGENT SERVER CONFIGURATION
# Default: Qwen3-VL-30B-A3B-Instruct served through vLLM on an NVIDIA H200.
# Gemini Cloud is kept as an opt-in fallback.
# ==============================================================================

# Server Network & Process Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
WORKERS=1
TIMEOUT_KEEP_ALIVE=30
BACKLOG=2048
LIMIT_CONCURRENCY=1000

# CORS & Extension Security
# In production, set to your extension's ID: CORS_ORIGINS=chrome-extension://<extension-id>
CORS_ORIGINS=*

# Shared-Secret Bearer Token (optional for local dev, mandatory for shared deployment)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# Concurrency & Backpressure Guard
MAX_CONCURRENT_REQUESTS=32
REQUEST_QUEUE_TIMEOUT=30.0

# Prompt & Prefix Caching Layer (APC memoization)
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_SIZE=1024
PROMPT_CACHE_TTL=3600.0

# Async Micro-Batch Coordinator (dynamic continuous batching)
BATCHING_ENABLED=false
BATCH_MAX_SIZE=8
BATCH_MAX_DELAY_MS=15.0

# ==============================================================================
# BACKEND MODES: vllm (default) | gemini_cloud | local_vlm | llamacpp | auto
# ==============================================================================
BACKEND_MODE=vllm

# ------------------------------------------------------------------------------
# vLLM — Qwen3-VL-30B-A3B-Instruct on NVIDIA H200 (RECOMMENDED)
#
# MoE architecture: 30B total params, ~3B active per token.
# BF16 fits in ~60 GB with headroom for long context + KV cache + vision tower.
# No quantization — the H200 has plenty of VRAM and VL quant kernels are
# still immature in vLLM.
#
# NOTE: The gateway listens on PORT (default 8000); vLLM must run on a DIFFERENT
# port on the same host (default 8001). VLLM_ENDPOINT below points at the vLLM
# OpenAI-compatible API, not at this gateway.
# ------------------------------------------------------------------------------
VLLM_ENDPOINT=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
VLLM_DTYPE=bfloat16
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=32768
VLLM_LIMIT_MM_PER_PROMPT=image=2
VLLM_TOOL_CALL_PARSER=hermes
VLLM_ENABLE_AUTO_TOOL_CHOICE=true
KV_CACHE_DTYPE=auto
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=8192
TENSOR_PARALLEL_SIZE=1
ENFORCE_EAGER=false
VLLM_API_KEY=

# ------------------------------------------------------------------------------
# Gemini Cloud (opt-in fallback). The extension chooses this via Settings.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ------------------------------------------------------------------------------
# Secondary local VLM via Ollama / generic OpenAI-compatible proxy.
# Only used when BACKEND_MODE=local_vlm.
# ------------------------------------------------------------------------------
LOCAL_VLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
LOCAL_VLM_ENDPOINT=http://localhost:11434/v1
DEVICE=auto

# ------------------------------------------------------------------------------
# Minimal-resource fallback (llama.cpp / CPU-only). Not used in the default
# H200 deployment; kept for low-end dev machines.
# ------------------------------------------------------------------------------
LLAMACPP_ENDPOINT=http://localhost:8080/v1
LLAMACPP_MODEL=qwen3-vl-30b-a3b-instruct-q4_k_m.gguf
LLAMACPP_THREADS=6
LLAMACPP_N_GPU_LAYERS=0
