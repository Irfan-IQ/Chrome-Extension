HOST=127.0.0.1
PORT=8000
DEBUG=true

# Comma-separated allowed CORS origins. Defaults to "*" (dev only).
# For production, set to your extension's origin:
# CORS_ORIGINS=chrome-extension://your-extension-id-here
CORS_ORIGINS=*

# Shared-secret bearer token. Leave blank for solo-local dev. For anything
# shared, generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The extension must send this value as the `X-Redact-Agent-Token` header
# (set it in chrome.storage.local under key `serverToken` via Settings).
AUTH_TOKEN=

# gemini_cloud or local_vlm
BACKEND_MODE=gemini_cloud

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LOCAL_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
LOCAL_VLM_ENDPOINT=http://localhost:11434/v1
DEVICE=auto
